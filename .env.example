# Model Price Hub 配置示例
# 复制为 .env 后按需修改；所有应用配置项均以 MPH_ 为前缀。
# 注意：.env 已被 .gitignore 忽略，切勿提交真实凭据。

# ---- 后台管理 ----
# 生产环境必须修改默认口令；留空则禁用后台登录。
MPH_ADMIN_USERNAME=admin
MPH_ADMIN_PASSWORD=
# HTTPS 部署时置为 true
MPH_ADMIN_COOKIE_SECURE=false

# ---- 抓取 ----
# 可选出站代理，例如 http://127.0.0.1:7890；不设置则直连。
MPH_HTTP_PROXY=
# 启用 Playwright 浏览器渲染（需安装 render 额外依赖并下载 Chromium）
MPH_USE_PLAYWRIGHT=0
# 渲染类抓取器并发上限（每个并发会拉起一个 Chromium，内存敏感）
MPH_RENDER_CONCURRENCY=1

# ---- 视觉提取（截图 → 多模态模型 → 结构化 JSON，可选）----
# 缺失凭据时视觉源自动跳过，降级为正则兜底解析。
MPH_ANTHROPIC_API_KEY=
# 兼容标准 Anthropic SDK 环境变量（二选一即可）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
MPH_VISION_MODEL=claude-sonnet-4-6

# ---- 调度 ----
MPH_SCHEDULE_INTERVAL_DAYS=3
MPH_SCHEDULE_HOUR=3
MPH_SCHEDULE_MINUTE=17

# ---- Discovery 搜索（可选）----
# 自托管 SearXNG 地址，参见 deploy/searxng/
MPH_SEARXNG_URL=

# ---- 告警（可选）----
# 价格管线异常时的通知 Webhook
MPH_ALERT_WEBHOOK=
